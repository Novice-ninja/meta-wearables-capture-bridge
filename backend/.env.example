# Public/LAN URL reachable by both the iPhone and Hermes/OpenClaw.
CAPTURE_BRIDGE_PUBLIC_URL=http://192.168.1.50:8000
CAPTURE_BRIDGE_DATA_DIR=./data
# Optional shared key. The iOS client sends it as X-Capture-Key.
CAPTURE_BRIDGE_API_KEY=change-me
# Optional generic POST target for wearable.capture.created notifications.
AGENT_WEBHOOK_URL=http://127.0.0.1:3000/hooks/wearable-capture
# Native OpenClaw agent ingress. It receives only a small manifest/media-URL
# message; keep this server reachable from OpenClaw.
OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_HOOK_TOKEN=
OPENCLAW_AGENT_ID=
